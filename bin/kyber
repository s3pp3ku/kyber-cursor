#!/usr/bin/env bash
# kyber: build, apply and control the Kyber cursor.
#
#   kyber apply          build the cursor in the current Omarchy accent and switch to it
#   kyber off            go back to the Adwaita cursor (the glow stops too)
#   kyber sound [mode]   all | ignite | mute | cycle (default: cycle)
#   kyber trail [on|off]  the drag trail (default: toggle)
#   kyber color theme|custom|random|#rrggbb   where the glow color comes from
#   kyber random               roll a new random color now
#   kyber volume 0-100         sound volume
#   kyber status         what is installed and running
set -euo pipefail

PLUGIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
THEME=Omarchy-Kyber
SIZE="${HYPRCURSOR_SIZE:-${XCURSOR_SIZE:-24}}"
ICONS="$HOME/.local/share/icons"
BUILDS="$ICONS/.kyber-builds"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/kyber-cursor"

accent() {
  /usr/bin/python3 - <<'PY' 2>/dev/null || true
import tomllib
from pathlib import Path
for p in (Path.home() / '.local/state/omarchy/current/theme/colors.toml',
          Path.home() / '.config/omarchy/current/theme/colors.toml'):
    if p.is_file():
        try:
            print(tomllib.loads(p.read_text()).get('accent', ''))
            break
        except Exception:
            pass
PY
}

# Install a built theme directory under $ICONS atomically: build into a
# throwaway directory, then repoint a symlink (one rename()), so a cursor
# reload never reads a half-written theme.
install_theme() {
  local name=$1 src=$2 acc=$3 recipe=$4
  local target="$BUILDS/$name.$$.$(date +%s%N)"
  cp -a "$src" "$target"
  printf '%s' "$acc" > "$target/.accent"
  printf '%s' "$recipe" > "$target/.recipe"
  if [[ -d $ICONS/$name && ! -L $ICONS/$name ]]; then
    mv -T "$ICONS/$name" "$BUILDS/$name.previous"
  fi
  ln -sfn "$target" "$ICONS/.$name.link.$$"
  mv -T "$ICONS/.$name.link.$$" "$ICONS/$name"
  local old
  for old in "$BUILDS/$name".*; do
    if [[ -e $old && $old != "$target" ]]; then rm -rf "$old"; fi
  done
  return 0
}

# ---- glow color: three modes -------------------------------------------------
#   theme   follow the Omarchy theme's accent (default)
#   custom  a color the user picked (`kyber color #rrggbb`)
#   random  a vivid random color, re-rolled when the Omarchy theme changes and
#           at boot (not on a shell reload or plugin update), or on demand
color_mode() {
  local m; m=$(cat "$STATE/color-mode" 2>/dev/null || true)
  case $m in theme|custom|random) echo "$m"; return 0 ;; esac
  # settings from 1.1.0 had only a color file
  if [[ -f $STATE/color ]]; then echo custom; else echo theme; fi
}

# A random color that always glows well: vivid and bright, and a clearly
# different hue from the last one.
roll_color() {
  local prev tmp; prev=$(cat "$STATE/random-color" 2>/dev/null || true)
  tmp=$(mktemp)
  /usr/bin/python3 - "$prev" > "$tmp" <<'PY'
import colorsys, random, sys
prev = sys.argv[1]
ph = None
if len(prev) == 7 and prev[0] == '#':
    try:
        ph = colorsys.rgb_to_hsv(*[int(prev[i:i + 2], 16) / 255 for i in (1, 3, 5)])[0]
    except ValueError:
        pass
while True:
    h = random.random()
    if ph is None or min(abs(h - ph), 1 - abs(h - ph)) >= 0.17:
        break
r, g, b = colorsys.hsv_to_rgb(h, random.uniform(0.65, 0.95), random.uniform(0.85, 1.0))
print('#%02x%02x%02x' % (round(r * 255), round(g * 255), round(b * 255)))
PY
  if [[ $(cat "$tmp") =~ ^#[0-9a-f]{6}$ ]]; then mv "$tmp" "$STATE/random-color"; else rm -f "$tmp"; fi
  note_roll_context
}

# What a roll belongs to: this Omarchy theme in this boot. A new theme or a new
# boot means "time for a new random color"; a shell reload does not.
roll_context() {
  # (|| true: a missing file must not trip `set -e` through the pipeline)
  local t; t=$( (cat "$HOME/.local/state/omarchy/current/theme.name" "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || true) | head -1)
  echo "$t|$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
}
note_roll_context() { roll_context > "$STATE/roll-context"; }

effective_color() {
  case $(color_mode) in
    custom) cat "$STATE/color" 2>/dev/null ;;
    random)
      if [[ ! -s $STATE/random-color || $(roll_context) != "$(cat "$STATE/roll-context" 2>/dev/null)" ]]; then roll_color; fi
      cat "$STATE/random-color" ;;
    *) accent ;;
  esac
}

cmd_apply() {
  local acc recipe cached="" existing
  mkdir -p "$STATE"
  acc=$(effective_color || true)
  [[ $acc =~ ^#[0-9a-fA-F]{6}$ ]] || acc=$(accent)
  [[ $acc =~ ^#[0-9a-fA-F]{6}$ ]] || acc="#7aa2f7"   # no Omarchy theme found: a neutral blue
  recipe=$(cat "$PLUGIN_DIR/lib/build.py" | sha256sum | cut -d' ' -f1)
  mkdir -p "$ICONS" "$BUILDS" "$STATE"
  for existing in "$BUILDS/$THEME".*; do
    [[ -f $existing/.accent && -f $existing/.recipe ]] || continue
    if [[ $(<"$existing/.accent") == "${acc,,}" && $(<"$existing/.recipe") == "$recipe" ]]; then cached=$existing; break; fi
  done
  if [[ -z $cached ]]; then
    local out; out=$(mktemp -d)
    /usr/bin/python3 "$PLUGIN_DIR/lib/build.py" --accent "$acc" --output "$out" >/dev/null
    local d
    for d in "$out"/*/; do install_theme "$(basename "${d%/}")" "${d%/}" "${acc,,}" "$recipe"; done
    rm -rf "$out"
  fi
  : > "$STATE/active"
  set_cursor "$THEME"
  echo "Kyber applied (accent ${acc,,}, size $SIZE)."
}

# Hyprland skips reloading when asked for the theme name it already has, so
# bounce through another theme first; retry because its cursor reload can stall.
set_cursor() {
  local theme=$1 bounce=Adwaita ok=0 i
  [[ $theme == Adwaita ]] && bounce=Omarchy-Kyber
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl setcursor "$bounce" "$SIZE" >/dev/null 2>&1 || true
    for i in 1 2 3; do
      if hyprctl setcursor "$theme" "$SIZE" >/dev/null 2>&1; then ok=1; break; fi
      sleep 0.4
    done
    [[ $ok -eq 1 ]] || echo "Hyprland did not answer; the cursor will update on your next theme switch or re-login." >&2
  fi
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null || true
  fi
}

cmd_off() {
  rm -f "$STATE/active"
  set_cursor Adwaita
  echo "Kyber off: back to the Adwaita cursor."
}

cmd_sound() {
  mkdir -p "$STATE"
  local f="$STATE/sound-mode" cur next
  cur=$(cat "$f" 2>/dev/null || echo all)
  case "${1:-cycle}" in
    all|ignite|mute) next=$1 ;;
    cycle) case $cur in all) next=ignite ;; ignite) next=mute ;; *) next=all ;; esac ;;
    *) echo "usage: kyber sound [all|ignite|mute|cycle]" >&2; exit 2 ;;
  esac
  echo "$next" > "$f"
  notify-send -t 1500 "Kyber sound: $next" 2>/dev/null || true
  echo "$next"
}

cmd_trail() {
  mkdir -p "$STATE"
  local f="$STATE/trail-mode" cur next
  cur=$(cat "$f" 2>/dev/null || echo on)
  case "${1:-toggle}" in
    on|off) next=$1 ;;
    toggle) [[ $cur == on ]] && next=off || next=on ;;
    *) echo "usage: kyber trail [on|off|toggle]" >&2; exit 2 ;;
  esac
  echo "$next" > "$f"
  notify-send -t 1500 "Kyber trail: $next" 2>/dev/null || true
  echo "$next"
}

cmd_color() {
  mkdir -p "$STATE"
  local v="${1:-}"
  case $v in
    "") echo "$(color_mode) $(effective_color)"; return 0 ;;
    theme|accent|none) echo theme > "$STATE/color-mode" ;;
    custom)
      # back to the last picked color (or the current accent if there is none yet)
      if [[ ! -f $STATE/color ]]; then accent > "$STATE/color"; fi
      echo custom > "$STATE/color-mode" ;;
    random)
      echo random > "$STATE/color-mode"
      if [[ ! -s $STATE/random-color ]]; then roll_color; else note_roll_context; fi ;;
    *) v=${v#\#}
       [[ $v =~ ^[0-9a-fA-F]{6}$ ]] || { echo "usage: kyber color theme | custom | random | #rrggbb" >&2; exit 2; }
       printf '#%s\n' "${v,,}" > "$STATE/color"
       echo custom > "$STATE/color-mode" ;;
  esac
  echo "$(color_mode) $(effective_color)"
  # rebuild right away if Kyber is the active cursor
  if [[ -f $STATE/active ]]; then cmd_apply >/dev/null; fi
}

# Roll a new random color now and switch to random mode.
cmd_random() {
  mkdir -p "$STATE"
  roll_color
  echo random > "$STATE/color-mode"
  cat "$STATE/random-color"
  if [[ -f $STATE/active ]]; then cmd_apply >/dev/null; fi
}

cmd_volume() {
  mkdir -p "$STATE"
  local f="$STATE/volume" v="${1:-}"
  if [[ -z $v ]]; then cat "$f" 2>/dev/null || echo 55; return 0; fi
  [[ $v =~ ^[0-9]+$ && $v -le 100 ]] || { echo "usage: kyber volume 0-100" >&2; exit 2; }
  echo "$v" > "$f"; echo "$v"
}

# One line of JSON with every setting, for the bar widget (and for scripts).
cmd_config() {
  local active=false mode eff; [[ -f $STATE/active ]] && active=true
  mode=$(color_mode)
  eff=theme; [[ $mode != theme ]] && eff=$(effective_color)
  printf '{"active":%s,"mode":"%s","color":"%s","custom":"%s","random":"%s","sound":"%s","trail":"%s","volume":%s}\n' "$active" \
    "$mode" "$eff" "$(cat "$STATE/color" 2>/dev/null || true)" "$(cat "$STATE/random-color" 2>/dev/null || true)" \
    "$(cat "$STATE/sound-mode" 2>/dev/null || echo all)" \
    "$(cat "$STATE/trail-mode" 2>/dev/null || echo on)" "$(cat "$STATE/volume" 2>/dev/null || echo 55)"
}

cmd_status() {
  echo "plugin:   $PLUGIN_DIR"
  echo "cursor:   $([[ -e $ICONS/$THEME ]] && echo "installed" || echo "not built (run: kyber apply)")"
  echo "active:   $([[ -f $STATE/active ]] && echo yes || echo no)"
  local glow; glow=$(systemctl --user is-active kyber-ignite.service 2>/dev/null || true)
  echo "glow:     ${glow:-not installed}"
  echo "sound:    $(cat "$STATE/sound-mode" 2>/dev/null || echo all)"
  echo "trail:    $(cat "$STATE/trail-mode" 2>/dev/null || echo on)"
  echo "color:    $(color_mode) ($(effective_color))"
  echo "volume:   $(cat "$STATE/volume" 2>/dev/null || echo 55)"
  local d n
  for d in ignite off clash; do
    n=$(find "$STATE/sounds/$d" -maxdepth 1 -type f 2>/dev/null | wc -l || true)
    echo "  sounds/$d: $n clip(s)"
  done
  if id -nG | tr ' ' '\n' | grep -qx input; then echo "input group: yes"; else echo "input group: NO (the click glow needs it, see README)"; fi
}

case "${1:-}" in
  apply)  cmd_apply ;;
  off)    cmd_off ;;
  sound)  shift; cmd_sound "$@" ;;
  trail)  shift; cmd_trail "$@" ;;
  color)  shift; cmd_color "$@" ;;
  random) cmd_random ;;
  volume) shift; cmd_volume "$@" ;;
  config) cmd_config ;;
  status) cmd_status ;;
  *) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; [[ -z ${1:-} ]] || exit 2 ;;
esac
