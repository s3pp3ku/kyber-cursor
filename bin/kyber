#!/usr/bin/env bash
# kyber: build, apply and control the Kyber cursor.
#
#   kyber apply          build the cursor in the current Omarchy accent and switch to it
#   kyber off            go back to the Adwaita cursor (the glow stops too)
#   kyber sound [mode]   all | ignite | mute | cycle (default: cycle)
#   kyber trail [on|off]  the drag trail (default: toggle)
#   kyber color theme|custom|random|#rrggbb   where the glow color comes from
#   kyber random               roll a new random color now
#   kyber volume 0-100         sound volume
#   kyber sounds default|add|list|preview   install or manage the selected sound pack
#   kyber setup [--yes] [--bar]  one-step setup: previews by default, --yes does it (never uses sudo)
#   kyber doctor               check dependencies and setup, and say how to fix anything
#   kyber status         what is installed and running
set -euo pipefail

PLUGIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
THEME=Omarchy-Kyber
SIZE="${HYPRCURSOR_SIZE:-${XCURSOR_SIZE:-24}}"
ICONS="$HOME/.local/share/icons"
BUILDS="$ICONS/.kyber-builds"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/kyber-cursor"

accent() {
  /usr/bin/python3 - <<'PY' 2>/dev/null || true
import tomllib
from pathlib import Path
for p in (Path.home() / '.local/state/omarchy/current/theme/colors.toml',
          Path.home() / '.config/omarchy/current/theme/colors.toml'):
    if p.is_file():
        try:
            print(tomllib.loads(p.read_text()).get('accent', ''))
            break
        except Exception:
            pass
PY
}

# Install a built theme directory under $ICONS atomically: build into a
# throwaway directory, then repoint a symlink (one rename()), so a cursor
# reload never reads a half-written theme.
install_theme() {
  local name=$1 src=$2 acc=$3 recipe=$4
  local target="$BUILDS/$name.$$.$(date +%s%N)"
  cp -a "$src" "$target"
  printf '%s' "$acc" > "$target/.accent"
  printf '%s' "$recipe" > "$target/.recipe"
  if [[ -d $ICONS/$name && ! -L $ICONS/$name ]]; then
    mv -T "$ICONS/$name" "$BUILDS/$name.previous"
  fi
  ln -sfn "$target" "$ICONS/.$name.link.$$"
  mv -T "$ICONS/.$name.link.$$" "$ICONS/$name"
  local old
  for old in "$BUILDS/$name".*; do
    if [[ -e $old && $old != "$target" ]]; then rm -rf "$old"; fi
  done
  return 0
}

# ---- glow color: three modes -------------------------------------------------
#   theme   follow the Omarchy theme's accent (default)
#   custom  a color the user picked (`kyber color #rrggbb`)
#   random  a vivid random color, re-rolled when the Omarchy theme changes and
#           at boot (not on a shell reload or plugin update), or on demand
color_mode() {
  local m; m=$(cat "$STATE/color-mode" 2>/dev/null || true)
  case $m in theme|custom|random) echo "$m"; return 0 ;; esac
  # settings from 1.1.0 had only a color file
  if [[ -f $STATE/color ]]; then echo custom; else echo theme; fi
}

# A random color that always glows well: vivid and bright, and a clearly
# different hue from the previous one ($1).
pick_random() {
  /usr/bin/python3 - "${1:-}" <<'PY'
import colorsys, random, sys
prev = sys.argv[1]
ph = None
if len(prev) == 7 and prev[0] == '#':
    try:
        ph = colorsys.rgb_to_hsv(*[int(prev[i:i + 2], 16) / 255 for i in (1, 3, 5)])[0]
    except ValueError:
        pass
while True:
    h = random.random()
    if ph is None or min(abs(h - ph), 1 - abs(h - ph)) >= 0.17:
        break
r, g, b = colorsys.hsv_to_rgb(h, random.uniform(0.65, 0.95), random.uniform(0.85, 1.0))
print('#%02x%02x%02x' % (round(r * 255), round(g * 255), round(b * 255)))
PY
}

# Roll the next random color. If a color was already built in the background
# (prebuild_next), use that one: applying it is then just a swap.
roll_color() {
  local prev nxt; prev=$(cat "$STATE/random-color" 2>/dev/null || true)
  nxt=$(cat "$STATE/random-next" 2>/dev/null || true)
  if [[ ! $nxt =~ ^#[0-9a-f]{6}$ || ! -f $BUILDS/next/${nxt#\#}/.recipe || $nxt == "$prev" ]]; then
    nxt=$(pick_random "$prev")
  fi
  if [[ $nxt =~ ^#[0-9a-f]{6}$ ]]; then printf '%s\n' "$nxt" > "$STATE/random-color"; fi
  rm -f "$STATE/random-next"
  note_roll_context
}

# In the background, pick the *next* random color and build it, so the next
# "Roll a new color" does not wait for a build. One color is kept; a lock stops
# two builds from overlapping.
prebuild_next() {
  (
    flock -n 9 || exit 0
    local cur nxt tmp recipe
    cur=$(cat "$STATE/random-color" 2>/dev/null || true)
    nxt=$(pick_random "$cur")
    [[ $nxt =~ ^#[0-9a-f]{6}$ ]] || exit 0
    recipe=$(cat "$PLUGIN_DIR/lib/build.py" | sha256sum | cut -d' ' -f1)
    mkdir -p "$BUILDS/next"
    tmp=$(mktemp -d "$BUILDS/next/.tmp.XXXXXX")
    if ! /usr/bin/python3 "$PLUGIN_DIR/lib/build.py" --accent "$nxt" --output "$tmp" >/dev/null 2>&1; then rm -rf "$tmp"; exit 0; fi
    printf '%s' "$recipe" > "$tmp/.recipe"
    local old
    for old in "$BUILDS/next"/*/; do
      [[ -d $old ]] && rm -rf "$old"
    done
    mv "$tmp" "$BUILDS/next/${nxt#\#}"
    printf '%s\n' "$nxt" > "$STATE/random-next"
  ) 9>"$STATE/.prebuild.lock" >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
}

# What a roll belongs to: this Omarchy theme in this boot. A new theme or a new
# boot means "time for a new random color"; a shell reload does not.
roll_context() {
  # (|| true: a missing file must not trip `set -e` through the pipeline)
  local t; t=$( (cat "$HOME/.local/state/omarchy/current/theme.name" "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || true) | head -1)
  echo "$t|$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
}
note_roll_context() { roll_context > "$STATE/roll-context"; }

effective_color() {
  case $(color_mode) in
    custom) cat "$STATE/color" 2>/dev/null ;;
    random)
      if [[ ! -s $STATE/random-color || $(roll_context) != "$(cat "$STATE/roll-context" 2>/dev/null)" ]]; then roll_color; fi
      cat "$STATE/random-color" ;;
    *) accent ;;
  esac
}

cmd_apply() {
  local acc recipe cached="" existing
  mkdir -p "$STATE"
  acc=$(effective_color || true)
  [[ $acc =~ ^#[0-9a-fA-F]{6}$ ]] || acc=$(accent)
  [[ $acc =~ ^#[0-9a-fA-F]{6}$ ]] || acc="#7aa2f7"   # no Omarchy theme found: a neutral blue
  recipe=$(cat "$PLUGIN_DIR/lib/build.py" | sha256sum | cut -d' ' -f1)
  mkdir -p "$ICONS" "$BUILDS" "$STATE"
  for existing in "$BUILDS/$THEME".*; do
    [[ -f $existing/.accent && -f $existing/.recipe ]] || continue
    if [[ $(<"$existing/.accent") == "${acc,,}" && $(<"$existing/.recipe") == "$recipe" ]]; then cached=$existing; break; fi
  done
  if [[ -z $cached ]]; then
    local out hex="${acc,,}" pre d
    hex=${hex#\#}; pre="$BUILDS/next/$hex"
    if [[ -f $pre/.recipe && $(<"$pre/.recipe") == "$recipe" ]]; then
      out=$pre                      # built ahead of time in the background: just install it
    else
      out=$(mktemp -d)
      /usr/bin/python3 "$PLUGIN_DIR/lib/build.py" --accent "$acc" --output "$out" >/dev/null
    fi
    for d in "$out"/*/; do install_theme "$(basename "${d%/}")" "${d%/}" "${acc,,}" "$recipe"; done
    rm -rf "$out"
  fi
  : > "$STATE/active"
  set_cursor "$THEME"
  echo "Kyber applied (accent ${acc,,}, size $SIZE)."
  if [[ $(color_mode) == random ]]; then prebuild_next; fi
}

# Hyprland skips reloading when asked for the theme name it already has, so
# bounce through another theme first; retry because its cursor reload can stall.
set_cursor() {
  local theme=$1 bounce=Adwaita ok=0 i
  [[ $theme == Adwaita ]] && bounce=Omarchy-Kyber
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl setcursor "$bounce" "$SIZE" >/dev/null 2>&1 || true
    for i in 1 2 3; do
      if hyprctl setcursor "$theme" "$SIZE" >/dev/null 2>&1; then ok=1; break; fi
      sleep 0.4
    done
    [[ $ok -eq 1 ]] || echo "Hyprland did not answer; the cursor will update on your next theme switch or re-login." >&2
  fi
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null || true
  fi
}

cmd_off() {
  rm -f "$STATE/active"
  set_cursor Adwaita
  echo "Kyber off: back to the Adwaita cursor."
}

cmd_sound() {
  mkdir -p "$STATE"
  local f="$STATE/sound-mode" cur next
  cur=$(cat "$f" 2>/dev/null || echo all)
  case "${1:-cycle}" in
    all|ignite|mute) next=$1 ;;
    cycle) case $cur in all) next=ignite ;; ignite) next=mute ;; *) next=all ;; esac ;;
    *) echo "usage: kyber sound [all|ignite|mute|cycle]" >&2; exit 2 ;;
  esac
  echo "$next" > "$f"
  notify-send -t 1500 "Kyber sound: $next" 2>/dev/null || true
  echo "$next"
}

cmd_trail() {
  mkdir -p "$STATE"
  local f="$STATE/trail-mode" cur next
  cur=$(cat "$f" 2>/dev/null || echo on)
  case "${1:-toggle}" in
    on|off) next=$1 ;;
    toggle) [[ $cur == on ]] && next=off || next=on ;;
    *) echo "usage: kyber trail [on|off|toggle]" >&2; exit 2 ;;
  esac
  echo "$next" > "$f"
  notify-send -t 1500 "Kyber trail: $next" 2>/dev/null || true
  echo "$next"
}

cmd_color() {
  mkdir -p "$STATE"
  local v="${1:-}"
  case $v in
    "") echo "$(color_mode) $(effective_color)"; return 0 ;;
    theme|accent|none) echo theme > "$STATE/color-mode" ;;
    custom)
      # back to the last picked color (or the current accent if there is none yet)
      if [[ ! -f $STATE/color ]]; then accent > "$STATE/color"; fi
      echo custom > "$STATE/color-mode" ;;
    random)
      echo random > "$STATE/color-mode"
      if [[ ! -s $STATE/random-color ]]; then roll_color; else note_roll_context; fi ;;
    *) v=${v#\#}
       [[ $v =~ ^[0-9a-fA-F]{6}$ ]] || { echo "usage: kyber color theme | custom | random | #rrggbb" >&2; exit 2; }
       printf '#%s\n' "${v,,}" > "$STATE/color"
       echo custom > "$STATE/color-mode" ;;
  esac
  echo "$(color_mode) $(effective_color)"
  # rebuild right away if Kyber is the active cursor
  if [[ -f $STATE/active ]]; then cmd_apply >/dev/null; fi
}

# Roll a new random color now and switch to random mode.
cmd_random() {
  mkdir -p "$STATE"
  roll_color
  echo random > "$STATE/color-mode"
  cat "$STATE/random-color"
  if [[ -f $STATE/active ]]; then cmd_apply >/dev/null; fi
}

cmd_volume() {
  mkdir -p "$STATE"
  local f="$STATE/volume" v="${1:-}"
  if [[ -z $v ]]; then cat "$f" 2>/dev/null || echo 55; return 0; fi
  [[ $v =~ ^[0-9]+$ && $v -le 100 ]] || { echo "usage: kyber volume 0-100" >&2; exit 2; }
  echo "$v" > "$f"; echo "$v"
}

# One line of JSON with every setting, for the bar widget (and for scripts).
cmd_config() {
  local active=false mode eff; [[ -f $STATE/active ]] && active=true
  mode=$(color_mode)
  eff=theme; [[ $mode != theme ]] && eff=$(effective_color)
  printf '{"active":%s,"mode":"%s","color":"%s","custom":"%s","random":"%s","sound":"%s","trail":"%s","volume":%s}\n' "$active" \
    "$mode" "$eff" "$(cat "$STATE/color" 2>/dev/null || true)" "$(cat "$STATE/random-color" 2>/dev/null || true)" \
    "$(cat "$STATE/sound-mode" 2>/dev/null || echo all)" \
    "$(cat "$STATE/trail-mode" 2>/dev/null || echo on)" "$(cat "$STATE/volume" 2>/dev/null || echo 55)"
}

# ---- sounds ------------------------------------------------------------------
# Setup copies the included recording files. No audio downloads or synthesis
# occur during setup. Users can override individual sound roles.
audio_files() { find "$1" -maxdepth 1 -type f \( -iname '*.wav' -o -iname '*.mp3' -o -iname '*.ogg' -o -iname '*.oga' -o -iname '*.flac' \) 2>/dev/null || true; }

cmd_sounds() {
  local sub="${1:-list}"; shift || true
  local kind dir n f tmp
  case $sub in
    default)
      /usr/bin/python3 "$PLUGIN_DIR/lib/sound_pack.py" "$STATE/sounds" ;;
    add)
      kind="${2:-}"; f="${1:-}"
      [[ -f $f && $kind =~ ^(ignite|off|clash|swipe|hum)$ ]] || { echo "usage: kyber sounds add FILE ignite|off|clash|swipe|hum" >&2; exit 2; }
      case ${f,,} in *.wav|*.mp3|*.ogg|*.oga|*.flac) ;; *) echo "use a .wav, .mp3, .ogg or .flac file" >&2; exit 2 ;; esac
      mkdir -p "$STATE/sounds/$kind"
      cp -n "$f" "$STATE/sounds/$kind/"
      echo "added to sounds/$kind. Only use clips you have the right to use." ;;
    list)
      for kind in ignite off clash swipe hum; do
        n=$(audio_files "$STATE/sounds/$kind" | wc -l)
        echo "$kind: $n clip(s)"
        audio_files "$STATE/sounds/$kind" | sort | sed 's|.*/|  |'
      done ;;
    preview)
      local gain
      gain=$(/usr/bin/python3 - "$STATE/volume" <<'PY'
import sys
try:
    v = int(open(sys.argv[1]).read().strip())
except Exception:
    v = 55
print('%.4f' % ((max(0, min(100, v)) / 100.0) ** 3))
PY
)
      for kind in ignite off clash swipe hum; do
        f=$(audio_files "$STATE/sounds/$kind" | sort -R | head -1)
        [[ -n $f ]] || { echo "$kind: no clips (run: kyber sounds default)"; continue; }
        echo "playing $kind: $(basename "$f")"
        pw-play --volume "$gain" "$f" || true
        sleep 0.3
      done ;;
    *) echo "usage: kyber sounds default [--force] | add FILE ignite|off|clash | list | preview" >&2; exit 2 ;;
  esac
}

# ---- doctor ------------------------------------------------------------------
# Checks everything Kyber depends on and prints the fix for anything missing.
# It only reads; it never changes the system and never runs sudo.
cmd_doctor() {
  local bad=0
  ok()   { printf '  [ok]   %s\n' "$1"; }
  fail() { printf '  [FIX]  %s\n         -> %s\n' "$1" "$2"; bad=1; }
  note() { printf '  [note] %s\n' "$1"; }

  echo "Dependencies"
  if /usr/bin/python3 -c 'import gi, cairo, PIL, cairosvg, evdev
gi.require_version("Gtk","4.0"); gi.require_version("Gtk4LayerShell","1.0")' 2>/dev/null; then ok "Python modules (gobject, cairo, pillow, cairosvg, evdev, gtk4, gtk4-layer-shell)"
  else fail "A Python module is missing" "sudo pacman -S --needed python-gobject python-cairo python-pillow python-cairosvg python-evdev gtk4 gtk4-layer-shell"; fi
  [[ -e /usr/lib/libgtk4-layer-shell.so ]] && ok "libgtk4-layer-shell" || fail "libgtk4-layer-shell.so not found" "sudo pacman -S --needed gtk4-layer-shell"
  for c in hyprctl grim pw-play; do
    command -v "$c" >/dev/null && ok "$c" || fail "$c not found" "install it (grim, pipewire; hyprctl comes with Hyprland)"
  done

  echo "Click glow"
  local ingroup=0
  if id -nG | tr ' ' '\n' | grep -qx input; then ingroup=1; ok "you are in the 'input' group"
  elif getent group input 2>/dev/null | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER"; then
    note "you have joined the 'input' group but it is not active yet. Restart the computer; the click glow then turns on by itself. (Nothing else to run.)"
  else note "the click glow is off: you are not in the 'input' group. That is optional. To turn it on: sudo usermod -aG input \"$USER\"   then restart the computer (it then starts by itself)."; fi
  if [[ $ingroup -eq 1 ]]; then
    if compgen -G "/dev/input/event*" >/dev/null && [[ -r $(ls /dev/input/event* 2>/dev/null | head -1) ]]; then ok "input devices are readable"
    else note "input devices are not readable by this session yet (a restart is needed after joining the group)"; fi
    local svc; svc=$(systemctl --user is-active kyber-ignite.service 2>/dev/null || true)
    if [[ $svc == active ]]; then ok "glow service is running"
    else fail "glow service is '${svc:-not installed}'" "run ./install.sh from the plugin folder, or: systemctl --user enable --now kyber-ignite.service"; fi
  fi

  echo "Cursor"
  [[ -e $ICONS/$THEME ]] && ok "cursor theme is built" || fail "cursor theme not built" "kyber apply"
  [[ -f $STATE/active ]] && ok "Kyber is the active cursor" || note "Kyber is off (kyber apply turns it on)"
  local h; for h in theme-set.d post-boot.d; do
    [[ -x ${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/$h/kyber-cursor.sh ]] && ok "$h hook installed" || note "no $h hook (the cursor will not follow theme changes): run ./install.sh"
  done

  echo "Sounds"
  local kind n
  for kind in ignite off clash; do
    n=$(audio_files "$STATE/sounds/$kind" | wc -l)
    if [[ $n -gt 0 ]]; then ok "sounds/$kind: $n clip(s)"; else note "sounds/$kind is empty: kyber sounds default"; fi
  done
  echo
  if [[ $bad -eq 0 ]]; then
    if [[ $ingroup -eq 1 ]]; then echo "Everything checks out."; else echo "Everything checks out. (The optional click glow is off.)"; fi
  else echo "Fix the [FIX] items above, then run: kyber doctor"; return 1; fi
}

# ---- setup -------------------------------------------------------------------
# One command for the non-privileged part of setting Kyber up. With no flags it
# only PREVIEWS (changes nothing); --yes does it. It never runs sudo and never
# restarts the desktop shell: anything like that is left on a checklist for
# the person (or the agent helping them, after asking).
cmd_setup() {
  local yes=0 bar=0 a missing=0 opts="--yes"
  for a in "$@"; do
    case $a in --yes) yes=1 ;; --bar) bar=1 ;; *) echo "usage: kyber setup [--yes] [--bar]" >&2; exit 2 ;; esac
  done
  cat <<MSG
Kyber Cursor setup
  Will do:
    - make a small set of cursor files in your home folder (a 'Kyber' cursor in your theme's color)
    - add one background helper that lights the cursor while you hold a mouse button
    - make it recolor itself when you change Omarchy themes
    - copy the included sound recordings (nothing is downloaded separately)
MSG
  if ((bar)); then echo "    - put a small Kyber button on your top bar (this edits your bar)"; fi
  echo "  Will NOT do: use sudo, download anything, change system files, or restart anything."
  if ((! yes)); then
    echo
    echo "That was only a preview. To go ahead: $PLUGIN_DIR/bin/kyber setup --yes   (add --bar for the bar button)"
    return 0
  fi

  ((bar)) && opts="--yes --bar"
  echo
  echo "Checking what Kyber needs..."
  if ! /usr/bin/python3 -c 'import gi, cairo, PIL, cairosvg, evdev
gi.require_version("Gtk","4.0"); gi.require_version("Gtk4LayerShell","1.0")' 2>/dev/null; then missing=1; fi
  command -v grim >/dev/null || missing=1
  command -v hyprctl >/dev/null || missing=1
  command -v pw-play >/dev/null || missing=1
  [[ -e /usr/lib/libgtk4-layer-shell.so ]] || missing=1
  if ((missing)); then
    cat <<MSG

A few programs Kyber needs are not installed yet. This one needs your computer's
password, so please run it yourself (an assistant should not run it for you):

  sudo pacman -S --needed python-gobject python-cairo python-pillow python-cairosvg python-evdev gtk4 gtk4-layer-shell grim pipewire

Then run this again, with the same options:  $PLUGIN_DIR/bin/kyber setup $opts
MSG
    return 3
  fi

  "$PLUGIN_DIR/install.sh" --yes
  if ((bar)); then
    if command -v omarchy >/dev/null; then omarchy bar put io.github.s3pp3ku.kyber-cursor || echo "Could not place the bar button; try: omarchy bar put io.github.s3pp3ku.kyber-cursor"
    else echo "Could not place the bar button (the 'omarchy' command was not found)."; fi
  fi

  echo
  echo "Done with the automatic part. What is left, for you:"
  local n=1
  if ! id -nG | tr ' ' '\n' | grep -qx input; then
    echo "  $n. (Optional, for the click glow) Allow Kyber to see mouse clicks. This needs your password and a restart,"
    echo "     and lets programs you run read raw input, including the keyboard. Only do it if you are comfortable with that:"
    echo "       sudo usermod -aG input \"$USER\"     then restart the computer."
    echo "     Without this you still get the cursor and its color; only the glow, trail and sounds stay off."
    n=$((n + 1))
  fi
  if ((bar)); then
    echo "  $n. Restart the desktop shell once so the Kyber button can load (the bar flickers for a few seconds):"
    echo "       omarchy-restart-shell"
    n=$((n + 1))
  fi
  echo "  $n. Check everything:  kyber doctor"
  echo
  "$PLUGIN_DIR/bin/kyber" doctor || true
}

cmd_status() {
  echo "plugin:   $PLUGIN_DIR"
  echo "cursor:   $([[ -e $ICONS/$THEME ]] && echo "installed" || echo "not built (run: kyber apply)")"
  echo "active:   $([[ -f $STATE/active ]] && echo yes || echo no)"
  local glow; glow=$(systemctl --user is-active kyber-ignite.service 2>/dev/null || true)
  echo "glow:     ${glow:-not installed}"
  echo "sound:    $(cat "$STATE/sound-mode" 2>/dev/null || echo all)"
  echo "trail:    $(cat "$STATE/trail-mode" 2>/dev/null || echo on)"
  echo "color:    $(color_mode) ($(effective_color))"
  echo "volume:   $(cat "$STATE/volume" 2>/dev/null || echo 55)"
  local d n
  for d in ignite off clash; do
    n=$(find "$STATE/sounds/$d" -maxdepth 1 -type f 2>/dev/null | wc -l || true)
    echo "  sounds/$d: $n clip(s)"
  done
  if id -nG | tr ' ' '\n' | grep -qx input; then echo "input group: yes"; else echo "input group: NO (the click glow needs it, see README)"; fi
}

case "${1:-}" in
  apply)  cmd_apply ;;
  off)    cmd_off ;;
  sound)  shift; cmd_sound "$@" ;;
  trail)  shift; cmd_trail "$@" ;;
  color)  shift; cmd_color "$@" ;;
  random) cmd_random ;;
  sounds) shift; cmd_sounds "$@" ;;
  doctor) cmd_doctor ;;
  setup)  shift; cmd_setup "$@" ;;
  volume) shift; cmd_volume "$@" ;;
  config) cmd_config ;;
  status) cmd_status ;;
  *) sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; [[ -z ${1:-} ]] || exit 2 ;;
esac
