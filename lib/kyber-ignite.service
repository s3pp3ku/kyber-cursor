[Unit]
Description=Kyber Cursor Rust glow and sound runtime
After=graphical-session.target
PartOf=graphical-session.target
ConditionGroup=input

[Service]
Type=simple
ExecStart=%h/.local/share/kyber-cursor/rust/kyber-ignite
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
